# ===========================================
# FRONTEND ENVIRONMENT VARIABLES
# ===========================================
# Скопируйте этот файл в .env и заполните своими значениями

# ===========================================
# API CONFIGURATION
# ===========================================
# Backend API URL
# Локальная разработка:
VITE_API_URL=http://localhost:3000/api

# Production:
# VITE_API_URL=https://api.your-domain.com/api

# WebSocket URL для чата
# VITE_WS_URL=http://localhost:3000
# VITE_WS_URL=https://api.your-domain.com

# ===========================================
# TELEGRAM
# ===========================================
# ID вашего бота (опционально, для дополнительной валидации)
# VITE_TELEGRAM_BOT_ID=1234567890

# ===========================================
# MAPS
# ===========================================
# Mapbox Token (если используете Mapbox)
# Получите на https://www.mapbox.com
# VITE_MAPBOX_TOKEN=pk.xxx

# Google Maps API Key (если используете Google Maps)
# VITE_GOOGLE_MAPS_API_KEY=AIzaSyXxx

# ===========================================
# ANALYTICS (опционально)
# ===========================================
# Google Analytics
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Yandex Metrica
# VITE_YANDEX_METRICA_ID=12345678

# ===========================================
# MONITORING (опционально)
# ===========================================
# Sentry DSN для отслеживания ошибок
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# ===========================================
# FEATURE FLAGS (опционально)
# ===========================================
# Включить/выключить функции
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_MAPS=true

# ===========================================
# APP CONFIGURATION
# ===========================================
# Название приложения
VITE_APP_NAME=Israeli Real Estate

# Язык по умолчанию
VITE_DEFAULT_LANGUAGE=he

# Поддерживаемые языки (разделяйте запятыми)
VITE_SUPPORTED_LANGUAGES=he,ru,en

# ===========================================
# IMAGE OPTIMIZATION
# ===========================================
# CDN URL для изображений (опционально)
# VITE_CDN_URL=https://cdn.your-domain.com

# Cloudinary Cloud Name (если используете Cloudinary)
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ===========================================
# DEVELOPMENT
# ===========================================
# Показывать debug информацию
VITE_DEBUG=false

# Mock API (для тестирования без бэкенда)
VITE_MOCK_API=false

# ===========================================
# NOTES
# ===========================================
# ВАЖНО:
# 1. Все переменные должны начинаться с VITE_
# 2. Эти переменные будут доступны в клиентском коде
# 3. НЕ храните секретные ключи здесь (они будут видны в bundle)
# 4. Для production используйте CI/CD для инжекции переменных
