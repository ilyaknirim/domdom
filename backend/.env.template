# ===========================================
# BACKEND ENVIRONMENT VARIABLES
# ===========================================
# Скопируйте этот файл в .env и заполните своими значениями

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# Локальная разработка:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/israeli_realestate?schema=public"

# Production (Railway.app, Heroku, etc):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ===========================================
# REDIS
# ===========================================
# Локальная разработка:
REDIS_URL="redis://localhost:6379"

# Production (Upstash, Redis Cloud, etc):
# REDIS_URL="redis://:password@host:port"

# ===========================================
# TELEGRAM BOT
# ===========================================
# Получите токен в @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz-1234567

# Имя вашего бота (опционально)
BOT_USERNAME=YourBotUsername

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Сгенерируйте случайную строку:
# openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# FILE UPLOAD (Cloudinary)
# ===========================================
# Зарегистрируйтесь на https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Или используйте AWS S3:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# ===========================================
# PAYMENT (опционально)
# ===========================================
# Telegram Stars (встроенные платежи)
# Получите через @BotFather -> Bot Settings -> Payments
TELEGRAM_PAYMENT_PROVIDER_TOKEN=your-payment-provider-token

# Stripe (опционально)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# EMAIL (опционально)
# ===========================================
# SendGrid
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_FROM_EMAIL=noreply@example.com

# Mailgun
# MAILGUN_API_KEY=key-xxx
# MAILGUN_DOMAIN=mg.example.com

# ===========================================
# SMS (опционально)
# ===========================================
# Twilio
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# MONITORING & LOGGING
# ===========================================
# Sentry (для отслеживания ошибок)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CORS
# ===========================================
# Разделяйте запятыми для нескольких доменов
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# ===========================================
# GOOGLE MAPS (опционально)
# ===========================================
# Для геокодинга и карт
# GOOGLE_MAPS_API_KEY=AIzaSyXxx

# ===========================================
# WEBHOOKS (опционально)
# ===========================================
# URL для получения Telegram webhook
# WEBHOOK_URL=https://your-domain.com/api/webhook/telegram

# ===========================================
# CRON JOBS
# ===========================================
# Отключить cron задачи в dev режиме
DISABLE_CRON=false

# ===========================================
# DEVELOPMENT TOOLS
# ===========================================
# Debug mode
DEBUG=false

# Enable GraphQL Playground
GRAPHQL_PLAYGROUND=true

# ===========================================
# NOTES
# ===========================================
# ВАЖНО:
# 1. Никогда не коммитьте .env файл в git!
# 2. Используйте разные значения для dev/staging/production
# 3. В production используйте сильные пароли (20+ символов)
# 4. Регулярно ротируйте секреты
# 5. Используйте secrets manager для production (AWS Secrets Manager, HashiCorp Vault, etc)

# Сгенерировать случайные секреты:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# или
# openssl rand -base64 32
